  "query": "SELECT p.id, p.username, p.avatar_url, p.country, p.`rank`, p.eliminated, CAST(COALESCE(ps.score, 0) AS SIGNED) as `score: i32`\n         FROM Players p\n         LEFT JOIN PlayerScores ps ON p.id = ps.player_id AND ps.round = ?\n         ORDER BY p.id",
