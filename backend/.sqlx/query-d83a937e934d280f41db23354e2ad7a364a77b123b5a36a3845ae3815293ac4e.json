{
  "db_name": "MySQL",
  "query": "\n        SELECT \n            p.id as `id!: i32`,\n            p.username,\n            p.avatar_url,\n            p.country,\n            p.`rank` as `rank!: i32`,\n            p.eliminated as `eliminated!: i8`,\n            COALESCE(pp.price, 0) as `price!: i32`\n        FROM TeamPlayers tp\n        JOIN Players p ON tp.player_id = p.id\n        LEFT JOIN PlayerPrices pp ON p.id = pp.player_id AND pp.round = ?\n        WHERE tp.team_id = ?\n        ",
