{
  "db_name": "MySQL",
  "query": "\n        SELECT \n            u.id as user_id,\n            t.id as team_id,\n            tp.player_id,\n            ps.score,\n            t.captain_id\n        FROM Users u\n        LEFT JOIN Teams t ON u.id = t.user_id\n        LEFT JOIN TeamPlayers tp ON t.id = tp.team_id\n        LEFT JOIN PlayerScores ps ON tp.player_id = ps.player_id AND ps.round = t.round\n        WHERE u.id = ?\n        ",
